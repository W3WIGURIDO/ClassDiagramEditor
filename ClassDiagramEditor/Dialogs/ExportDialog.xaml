<Window x:Class="ClassDiagramEditor.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エクスポート"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: エクスポート形式 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: 余白設定 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: 背景透過オプション ← 新規追加 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: クリップボード注記 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: ボタン -->
        </Grid.RowDefinitions>

        <!-- エクスポート形式 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="エクスポート形式" FontWeight="SemiBold" Margin="0,0,0,8" FontSize="13"/>
            <!-- [2026-03-24 追加] PNG・SVG・クリップボードの選択ラジオボタン -->
            <RadioButton x:Name="RadioPng"
                         Content="PNG 画像 (.png)"
                         IsChecked="True"
                         FontSize="13"
                         Margin="0,0,0,6"
                         GroupName="ExportFormat"/>
            <RadioButton x:Name="RadioSvg"
                         Content="SVG ベクター画像 (.svg)"
                         FontSize="13"
                         Margin="0,0,0,6"
                         GroupName="ExportFormat"/>
            <RadioButton x:Name="RadioClipboard"
                         Content="クリップボードにコピー (PNG)"
                         FontSize="13"
                         GroupName="ExportFormat"/>
        </StackPanel>

        <!-- 余白設定 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="余白 (px)" FontWeight="SemiBold" Margin="0,0,0,8" FontSize="13"/>
            <!-- [2026-03-24 追加] バウンディングボックスに追加する余白のスライダー -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="PaddingSlider"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="100"
                        Value="20"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ElementName=PaddingSlider, Path=Value, StringFormat={}{0}px}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="13"/>
            </Grid>
        </StackPanel>
        <!-- [2026-03-25 追加] 背景・グリッド透過オプション（PNG・クリップボード時のみ有効） -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <CheckBox x:Name="TransparentBackgroundCheckBox"
              Content="背景・グリッドを透過する（PNG・クリップボードのみ）"
              FontSize="13"
              IsChecked="False"/>
        </StackPanel>

        <!-- クリップボード選択時の注記 -->
        <Border Grid.Row="3"
                x:Name="ClipboardNote"
                Background="#E3F2FD"
                Padding="10"
                CornerRadius="3"
                BorderBrush="#2196F3"
                BorderThickness="1"
                Margin="0,0,0,15"
                Visibility="Collapsed">
            <TextBlock Text="💡 クリップボードにPNG形式でコピーします。ファイルは保存されません。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#555555"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="エクスポート"
                    x:Name="ExportButton"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="ExportButton_Click"
                    IsDefault="True"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <Button Content="キャンセル"
                    Width="100"
                    Height="35"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>