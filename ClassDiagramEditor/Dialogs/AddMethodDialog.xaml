<Window x:Class="ClassDiagramEditor.Dialogs.AddMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メソッドを追加" 
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- [2026-03-27 追加] パラメータセクション行 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メソッド名 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="メソッド名 *" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="13"/>
            <TextBox x:Name="NameTextBox" 
                     Padding="8" 
                     FontSize="13"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"/>
        </StackPanel>

        <!-- 戻り値の型 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="戻り値の型 *" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="13"/>
            <ComboBox x:Name="ReturnTypeComboBox" 
                      Padding="8" 
                      FontSize="13"
                      BorderBrush="#CCCCCC"
                      IsEditable="True">
                <ComboBoxItem Content="void" IsSelected="True"/>
                <ComboBoxItem Content="string"/>
                <ComboBoxItem Content="int"/>
                <ComboBoxItem Content="double"/>
                <ComboBoxItem Content="bool"/>
                <ComboBoxItem Content="decimal"/>
                <ComboBoxItem Content="DateTime"/>
                <ComboBoxItem Content="Task"/>
                <ComboBoxItem Content="Task&lt;T&gt;"/>
                <ComboBoxItem Content="IEnumerable&lt;T&gt;"/>
                <ComboBoxItem Content="object"/>
            </ComboBox>
        </StackPanel>

        <!-- アクセス修飾子 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="アクセス修飾子" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="13"/>
            <ComboBox x:Name="AccessModifierComboBox" 
                      Padding="8" 
                      FontSize="13"
                      BorderBrush="#CCCCCC">
                <ComboBoxItem Content="Public" IsSelected="True"/>
                <ComboBoxItem Content="Private"/>
                <ComboBoxItem Content="Protected"/>
                <ComboBoxItem Content="Internal"/>
            </ComboBox>
        </StackPanel>

        <!-- [2026-03-27 追加] パラメータセクション -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="パラメータ" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="13"/>

            <!-- パラメータ一覧ヘッダー -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <!-- [2026-03-27 追加] 削除ボタン列 -->
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="名前" FontSize="11" Foreground="#666666" Margin="2,0"/>
                <TextBlock Grid.Column="1" Text="型" FontSize="11" Foreground="#666666" Margin="2,0"/>
            </Grid>

            <!-- [2026-03-27 追加] パラメータ行リスト（ItemsSource はコードビハインドで設定） -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Background="White">
                <ItemsControl x:Name="ParameterItemsControl" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <!-- [2026-03-27 追加] 削除ボタン列 -->
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <!-- [2026-03-27 追加] 名前フィールド -->
                                <TextBox Grid.Column="0"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,3"
                                         FontSize="12"
                                         BorderBrush="#CCCCCC"
                                         Margin="0,0,4,0"/>
                                <!-- [2026-03-27 追加] 型フィールド -->
                                <ComboBox Grid.Column="1"
                                          Text="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Padding="4,3"
                                          FontSize="12"
                                          BorderBrush="#CCCCCC"
                                          Margin="0,0,4,0">
                                    <ComboBoxItem Content="string"/>
                                    <ComboBoxItem Content="int"/>
                                    <ComboBoxItem Content="double"/>
                                    <ComboBoxItem Content="bool"/>
                                    <ComboBoxItem Content="decimal"/>
                                    <ComboBoxItem Content="DateTime"/>
                                    <ComboBoxItem Content="Guid"/>
                                    <ComboBoxItem Content="object"/>
                                </ComboBox>
                                <!-- [2026-03-27 追加] 削除ボタン -->
                                <Button Grid.Column="2"
                                        Content="🗑️"
                                        FontSize="11"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        Background="#F44336"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="DeleteParameter_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- [2026-03-27 追加] パラメータ追加ボタン -->
            <Button Content="➕ パラメータを追加"
                    Margin="0,6,0,0"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    Click="AddParameter_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="12"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,5,0,0">
            <Button Content="OK" 
                    Width="100" 
                    Height="35"
                    Margin="0,0,10,0" 
                    Click="OkButton_Click" 
                    IsDefault="True"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <Button Content="キャンセル" 
                    Width="100" 
                    Height="35"
                    Click="CancelButton_Click" 
                    IsCancel="True"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>